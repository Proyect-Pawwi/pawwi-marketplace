# URL pública del sitio — usada en los links de confirmación/recuperación de email.
# EN PRODUCCIÓN ES OBLIGATORIA: sin ella, los emails apuntan a http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Secret del webhook de aprobación de pawwers (/api/pawwer/notify-approved).
# Sin este valor el endpoint queda deshabilitado (fail-closed).
PAWWI_WEBHOOK_SECRET=your_webhook_secret

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Wompi
WOMPI_PUBLIC_KEY=your_wompi_public_key

# Resend
RESEND_API_KEY=re_...
